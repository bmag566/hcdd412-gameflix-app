# Copy to ./application-local.properties (project root, next to pom.xml) and fill in.
# Or set env vars instead: SPRING_DATASOURCE_USERNAME, SPRING_DATASOURCE_PASSWORD, GAMEFLIX_JWT_SECRET
spring.datasource.username=YOUR_DB_USER
spring.datasource.password=YOUR_DB_PASSWORD
# Base64, at least 32 bytes. PowerShell:
#   $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
gameflix.jwt.secret=YOUR_BASE64_SECRET
